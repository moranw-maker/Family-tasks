rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions — FamilyTasks V1.6
    // Two-Role Authorization Model (PARENT / CHILD) + Personal FamilyIdentity (FATHER / MOTHER)
    // With Safe V1.5 -> V1.6 Legacy Migration & Compatibility Support
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParentRoleValue(role) {
      return role in ['PARENT', 'PRIMARY_ADMIN', 'ADMIN', 'PARENT_ADMIN', 'FATHER', 'MOTHER'];
    }

    function isChildRoleValue(role) {
      return role in ['CHILD', 'MEMBER_KID', 'MEMBER', 'SON', 'DAUGHTER'];
    }

    function isAllowedRoleValue(role) {
      return isParentRoleValue(role) || isChildRoleValue(role);
    }

    // Checks if the caller is a member of /families/{familyId} via either:
    // - An existing member document at /families/{familyId}/members/{uid}, OR
    // - Membership recorded on /families/{familyId} (memberIds, memberUids, createdById, createdBy, ownerUid)
    function isFamilyMember(familyId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        || (
          exists(/databases/$(database)/documents/families/$(familyId))
          && (
            request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('memberIds', [])
            || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('memberUids', [])
            || get(/databases/$(database)/documents/families/$(familyId)).data.get('createdById', '') == request.auth.uid
            || get(/databases/$(database)/documents/families/$(familyId)).data.get('createdBy', '') == request.auth.uid
            || get(/databases/$(database)/documents/families/$(familyId)).data.get('ownerUid', '') == request.auth.uid
          )
        )
      );
    }

    // Checks if the caller is a PARENT of /families/{familyId}.
    // Both FATHER and MOTHER have the PARENT authorization role.
    // Never grants PARENT privileges if an authoritative member document assigns a CHILD role.
    function isParent(familyId) {
      return isSignedIn() && familyId != '' && (
        (
          exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
          && isParentRoleValue(
            get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.get('role', '')
          )
        )
        || (
          !exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
          && exists(/databases/$(database)/documents/families/$(familyId))
          && (
            get(/databases/$(database)/documents/families/$(familyId)).data.get('createdById', '') == request.auth.uid
            || get(/databases/$(database)/documents/families/$(familyId)).data.get('createdBy', '') == request.auth.uid
            || get(/databases/$(database)/documents/families/$(familyId)).data.get('ownerUid', '') == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('adminUids', [])
          )
        )
      );
    }

    // Checks if the caller is a CHILD (non-parent member) of /families/{familyId}
    function isChild(familyId) {
      return isFamilyMember(familyId) && !isParent(familyId);
    }

    // Allows keeping the same canonical role OR migrating a legacy V1.5 role to its canonical V1.6 equivalent.
    // Strictly forbids escalating a child role ('CHILD', 'MEMBER_KID', 'MEMBER', 'SON', 'DAUGHTER') to 'PARENT'.
    function isSameOrMigratedRole(oldRole, newRole) {
      return (isParentRoleValue(newRole) && isParentRoleValue(oldRole))
        || (isChildRoleValue(newRole) && isChildRoleValue(oldRole));
    }

    // Validates that familyIdentity (if present) is consistent with role:
    // - FATHER and MOTHER are valid only for parent roles
    // - SON, DAUGHTER, and CHILD are valid for child roles
    function isValidFamilyIdentity(data) {
      return !('familyIdentity' in data)
        || (
          isParentRoleValue(data.get('role', 'PARENT'))
          && data.get('familyIdentity', '') in ['FATHER', 'MOTHER']
        )
        || (
          isChildRoleValue(data.get('role', 'CHILD'))
          && data.get('familyIdentity', '') in ['SON', 'DAUGHTER', 'CHILD']
        );
    }

    // Validates that a CHILD task update only modifies completion status fields
    // on a task assigned to that child, and never self-approves (cannot set approvedByParent to true)
    function isChildTaskCompletionOnly() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['isCompleted', 'completedAtMillis', 'completedByMemberId', 'updatedAt', 'approvedByParent'])
        && (!('approvedByParent' in changedKeys) || request.resource.data.get('approvedByParent', false) == false)
        && (
          !('completedByMemberId' in request.resource.data)
          || request.resource.data.completedByMemberId == null
          || request.resource.data.completedByMemberId == request.auth.uid
        )
        && (
          resource.data.get('assignedUid', '') == request.auth.uid
          || resource.data.get('assignedToMemberId', '') == request.auth.uid
          || resource.data.get('assignedMemberId', '') == request.auth.uid
        );
    }

    // Validates that a CHILD member update on their own member doc is strictly for reward redemption
    function isValidChildRewardSpend() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['spentPoints', 'updatedAt'])
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('earnedPoints', 0) == resource.data.get('earnedPoints', 0)
        && request.resource.data.get('spentPoints', -1) is int
        && request.resource.data.get('spentPoints', 0) > resource.data.get('spentPoints', 0)
        && request.resource.data.get('spentPoints', 0) <= resource.data.get('earnedPoints', 0);
    }

    // Validates invitation-based membership creation in /families/{familyId}/members/{uid}:
    // - /family_invites/{inviteCode} must exist, belong to {familyId}, and be unused/unrevoked/unexpired
    // - If invitedRole is present on the invite, the member's role must match it (otherwise must be a child role)
    // - If intendedEmail is present on the invite, the caller's auth token email must match it
    // - In the same atomic batch/transaction, the invitation must be marked as used/redeemed by request.auth.uid
    function isValidInviteRedemption(familyId, inviteCode, requestedRole) {
      let invitePath = /databases/$(database)/documents/family_invites/$(inviteCode);
      let beforeInvite = get(invitePath);
      let afterInvite = getAfter(invitePath);
      return inviteCode is string
        && inviteCode.size() >= 4
        && exists(invitePath)
        && beforeInvite.data.get('familyId', '') == familyId
        && beforeInvite.data.get('isRevoked', false) == false
        && beforeInvite.data.get('isUsed', false) == false
        && beforeInvite.data.get('status', 'PENDING') == 'PENDING'
        && (
          (
            ('invitedRole' in beforeInvite.data)
            && (
              beforeInvite.data.invitedRole == requestedRole
              || (beforeInvite.data.invitedRole == 'CHILD' && isChildRoleValue(requestedRole))
            )
          )
          || (
            !('invitedRole' in beforeInvite.data)
            && isChildRoleValue(requestedRole)
          )
        )
        && (
          !('intendedEmail' in beforeInvite.data)
          || beforeInvite.data.intendedEmail == ''
          || (request.auth.token.email != null && beforeInvite.data.intendedEmail == request.auth.token.email)
        )
        && (
          !(beforeInvite.data.get('expiresAtMillis', null) is int)
          || request.time.toMillis() <= beforeInvite.data.expiresAtMillis
        )
        && (
          !(beforeInvite.data.get('expiresAt', null) is int)
          || request.time.toMillis() <= beforeInvite.data.expiresAt
        )
        && afterInvite.data.get('isUsed', false) == true
        && (
          afterInvite.data.get('usedByUid', '') == request.auth.uid
          || afterInvite.data.get('redeemedByUid', '') == request.auth.uid
        )
        && (
          !('status' in afterInvite.data)
          || afterInvite.data.status == 'REDEEMED'
        );
    }

    // Validates that a joining user who has created (or is atomically creating) their member doc
    // only adds their own UID to memberIds / memberUids (and adminUids only if their member doc role is PARENT)
    function isSelfMemberListAppend(familyId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let oldMemberIds = resource.data.get('memberIds', []);
      let newMemberIds = request.resource.data.get('memberIds', oldMemberIds);
      let oldMemberUids = resource.data.get('memberUids', []);
      let newMemberUids = request.resource.data.get('memberUids', oldMemberUids);
      let oldAdminUids = resource.data.get('adminUids', []);
      let newAdminUids = request.resource.data.get('adminUids', oldAdminUids);
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
      return (exists(memberPath) || existsAfter(memberPath))
        && changedKeys.hasOnly(['memberIds', 'memberUids', 'adminUids', 'updatedAt'])
        && newMemberIds is list
        && newMemberIds.hasAll(oldMemberIds)
        && newMemberIds.toSet().difference(oldMemberIds.toSet()).hasOnly([request.auth.uid])
        && newMemberUids is list
        && newMemberUids.hasAll(oldMemberUids)
        && newMemberUids.toSet().difference(oldMemberUids.toSet()).hasOnly([request.auth.uid])
        && newAdminUids is list
        && newAdminUids.hasAll(oldAdminUids)
        && (
          newAdminUids.toSet().difference(oldAdminUids.toSet()).size() == 0
          || (
            newAdminUids.toSet().difference(oldAdminUids.toSet()).hasOnly([request.auth.uid])
            && isParentRoleValue(getAfter(memberPath).data.get('role', ''))
          )
        );
    }

    function isParentOfUserFamily(userId) {
      let targetUser = get(/databases/$(database)/documents/users/$(userId));
      return targetUser != null
        && targetUser.data.get('familyId', '') != ''
        && isParent(targetUser.data.get('familyId', ''));
    }

    // =========================================================================
    // 1. User Profiles (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || isAllowedRoleValue(request.resource.data.role))
        && isValidFamilyIdentity(request.resource.data);

      allow update: if (
        isOwner(userId)
        && (!('role' in request.resource.data) || isAllowedRoleValue(request.resource.data.role))
        && (
          !('role' in request.resource.data)
          || (
            ('role' in resource.data)
            && isSameOrMigratedRole(resource.data.role, request.resource.data.role)
          )
          || isChildRoleValue(request.resource.data.role)
          || isParent(request.resource.data.get('familyId', resource.data.get('familyId', '')))
        )
        && isValidFamilyIdentity(request.resource.data)
      ) || (
        isParentOfUserFamily(userId)
        && (!('role' in request.resource.data) || isAllowedRoleValue(request.resource.data.role))
        && isValidFamilyIdentity(request.resource.data)
      );

      allow delete: if isOwner(userId);

      // Multi-device FCM registration tokens associated with the authenticated user's UID.
      // Only the authenticated owner may read, register, refresh, or remove their own device tokens.
      match /fcm_tokens/{tokenId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('token', '') is string
          && request.resource.data.get('token', '').size() > 0
          && (!('platform' in request.resource.data) || request.resource.data.platform == 'ANDROID');
        allow delete: if isOwner(userId);
      }
    }

    // =========================================================================
    // 2. Families (/families/{familyId}) & Nested Subcollections
    // =========================================================================
    match /families/{familyId} {
      allow get, list: if isSignedIn();

      // Any signed-in user may create a new family with themselves as sole initial creator/member
      allow create: if isSignedIn()
        && (
          request.resource.data.get('createdById', '') == request.auth.uid
          || request.resource.data.get('createdBy', '') == request.auth.uid
          || request.resource.data.get('ownerUid', '') == request.auth.uid
        )
        && (
          !('memberIds' in request.resource.data)
          || (
            request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() == 1
            && request.resource.data.memberIds[0] == request.auth.uid
          )
        )
        && (
          !('memberUids' in request.resource.data)
          || (
            request.resource.data.memberUids is list
            && request.resource.data.memberUids.size() == 1
            && request.resource.data.memberUids[0] == request.auth.uid
          )
        );

      allow update: if (
        isParent(familyId)
        && (
          !('createdBy' in resource.data)
          || !('createdBy' in request.resource.data)
          || request.resource.data.createdBy == resource.data.createdBy
        )
        && (
          !('ownerUid' in resource.data)
          || !('ownerUid' in request.resource.data)
          || request.resource.data.ownerUid == resource.data.ownerUid
        )
      ) || isSelfMemberListAppend(familyId);

      allow delete: if isParent(familyId);

      // -----------------------------------------------------------------------
      // 2a. Family Members (/families/{familyId}/members/{memberId})
      // -----------------------------------------------------------------------
      match /members/{memberId} {
        allow get: if isOwner(memberId) || isFamilyMember(familyId);
        allow list: if isFamilyMember(familyId);

        allow create: if (
          // 1. Creator bootstrapping or migrating their own PARENT member record
          isOwner(memberId)
          && isParentRoleValue(request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
          && (
            (
              existsAfter(/databases/$(database)/documents/families/$(familyId))
              && (
                getAfter(/databases/$(database)/documents/families/$(familyId)).data.get('createdById', '') == request.auth.uid
                || getAfter(/databases/$(database)/documents/families/$(familyId)).data.get('createdBy', '') == request.auth.uid
                || getAfter(/databases/$(database)/documents/families/$(familyId)).data.get('ownerUid', '') == request.auth.uid
              )
            )
            || (
              exists(/databases/$(database)/documents/families/$(familyId))
              && (
                get(/databases/$(database)/documents/families/$(familyId)).data.get('createdById', '') == request.auth.uid
                || get(/databases/$(database)/documents/families/$(familyId)).data.get('createdBy', '') == request.auth.uid
                || get(/databases/$(database)/documents/families/$(familyId)).data.get('ownerUid', '') == request.auth.uid
                || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('adminUids', [])
              )
            )
          )
        ) || (
          // 2. Existing PARENT adding a member to the family
          isParent(familyId)
          && isAllowedRoleValue(request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
        ) || (
          // 3. Pre-registered member in memberIds / memberUids onboarding as a child without an inviteCode
          isOwner(memberId)
          && !('inviteCode' in request.resource.data)
          && exists(/databases/$(database)/documents/families/$(familyId))
          && (
            request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('memberIds', [])
            || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.get('memberUids', [])
          )
          && isChildRoleValue(request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
          && request.resource.data.get('earnedPoints', 0) == 0
          && request.resource.data.get('spentPoints', 0) == 0
        ) || (
          // 4. Authenticated user redeeming a valid invitation code atomically
          isOwner(memberId)
          && ('inviteCode' in request.resource.data)
          && isAllowedRoleValue(request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
          && request.resource.data.get('earnedPoints', 0) == 0
          && request.resource.data.get('spentPoints', 0) == 0
          && isValidInviteRedemption(familyId, request.resource.data.inviteCode, request.resource.data.get('role', ''))
        );

        allow update: if (
          isParent(familyId)
          && isAllowedRoleValue(request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
        ) || (
          isOwner(memberId)
          && isFamilyMember(familyId)
          && isAllowedRoleValue(request.resource.data.get('role', ''))
          && isSameOrMigratedRole(resource.data.get('role', ''), request.resource.data.get('role', ''))
          && isValidFamilyIdentity(request.resource.data)
          && request.resource.data.get('earnedPoints', 0) == resource.data.get('earnedPoints', 0)
          && request.resource.data.get('spentPoints', 0) == resource.data.get('spentPoints', 0)
        ) || (
          isOwner(memberId)
          && isChild(familyId)
          && isValidChildRewardSpend()
        );

        allow delete: if isParent(familyId);
      }

      // -----------------------------------------------------------------------
      // 2b. Family Tasks (/families/{familyId}/tasks/{taskId})
      // -----------------------------------------------------------------------
      match /tasks/{taskId} {
        allow get, list: if isFamilyMember(familyId);
        allow create: if isParent(familyId);
        allow update: if isParent(familyId)
          || (isChild(familyId) && isChildTaskCompletionOnly());
        allow delete: if isParent(familyId);
      }

      // -----------------------------------------------------------------------
      // 2c. Family Rewards (/families/{familyId}/rewards/{rewardId})
      // -----------------------------------------------------------------------
      match /rewards/{rewardId} {
        allow get, list: if isFamilyMember(familyId);
        allow create, update, delete: if isParent(familyId);
      }

      // -----------------------------------------------------------------------
      // 2d. Reward Redemptions (/families/{familyId}/redemptions/{redemptionId})
      // -----------------------------------------------------------------------
      match /redemptions/{redemptionId} {
        allow get, list: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.get('childUid', '') == request.auth.uid
          && request.resource.data.get('pointsCost', 0) is int
          && request.resource.data.get('pointsCost', 0) > 0
          && (
            get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.get('earnedPoints', 0)
            - get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.get('spentPoints', 0)
          ) >= request.resource.data.get('pointsCost', 0);
        allow update, delete: if isParent(familyId);
      }

      // -----------------------------------------------------------------------
      // 2e. Schedule Periods (/families/{familyId}/schedule/{periodId})
      // -----------------------------------------------------------------------
      match /schedule/{periodId} {
        allow get, list: if isFamilyMember(familyId);
        allow create, update, delete: if isParent(familyId);
      }

      // -----------------------------------------------------------------------
      // 2e-2. Family Alarm Clock (/families/{familyId}/alarms/{alarmId})
      // -----------------------------------------------------------------------
      match /alarms/{alarmId} {
        allow get, list: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyMember(familyId);
      }

      // -----------------------------------------------------------------------
      // 2f. Server-Side Notification Dispatches (/families/{familyId}/notification_dispatches/{dispatchId})
      // Managed exclusively by Firebase Cloud Functions (Admin SDK) for idempotency.
      // -----------------------------------------------------------------------
      match /notification_dispatches/{dispatchId} {
        allow read, write: if false;
      }

      // -----------------------------------------------------------------------
      // 2g. Shared Family Folders (/families/{familyId}/folders/{folderId})
      // Metadata index for subfolders inside the shared Google Drive `FamilyTasks` root folder.
      // Special exception for the Files section ONLY:
      // All active family members (both PARENT and CHILD) have equal folder-management
      // permissions (browse, create, rename, move, delete) inside their family's `FamilyTasks` folder.
      // Users from other families are strictly denied.
      // -----------------------------------------------------------------------
      match /folders/{folderId} {
        allow get, list: if isFamilyMember(familyId);

        allow create: if isFamilyMember(familyId)
          && request.resource.data.get('familyId', '') == familyId
          && request.resource.data.get('createdByUid', '') == request.auth.uid
          && request.resource.data.get('nameHe', '') is string
          && request.resource.data.get('nameHe', '').size() > 0
          && request.resource.data.get('nameHe', '').size() <= 120
          && !request.resource.data.get('nameHe', '').matches('.*(\\.\\.|/|\\\\).*');

        allow update: if isFamilyMember(familyId)
          && request.resource.data.get('familyId', familyId) == familyId
          && request.resource.data.get('nameHe', resource.data.get('nameHe', '')) is string
          && request.resource.data.get('nameHe', resource.data.get('nameHe', '')).size() > 0
          && request.resource.data.get('nameHe', resource.data.get('nameHe', '')).size() <= 120
          && !request.resource.data.get('nameHe', resource.data.get('nameHe', '')).matches('.*(\\.\\.|/|\\\\).*');

        allow delete: if isFamilyMember(familyId);
      }

      // -----------------------------------------------------------------------
      // 2h. Shared Family Files (/families/{familyId}/files/{fileId})
      // Non-binary metadata index for files stored exclusively in the shared Google Drive
      // `FamilyTasks` folder.
      // Special exception for the Files section ONLY:
      // All active family members (both PARENT and CHILD) have equal file-management
      // permissions (browse, open, upload, rename, move, delete) inside their family's `FamilyTasks` folder.
      // Users from other families are strictly denied.
      // -----------------------------------------------------------------------
      match /files/{fileId} {
        allow get, list: if isFamilyMember(familyId);

        allow create: if isFamilyMember(familyId)
          && request.resource.data.get('familyId', '') == familyId
          && request.resource.data.get('uploadedByUid', '') == request.auth.uid
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() > 0
          && request.resource.data.get('name', '').size() <= 160
          && !request.resource.data.get('name', '').matches('.*(\\.\\.|/|\\\\).*')
          && request.resource.data.get('extension', '') in [
            'PDF', 'JPG', 'JPEG', 'PNG', 'WEBP', 'DOC', 'DOCX', 'XLS', 'XLSX', 'PPT', 'PPTX', 'TXT', 'ZIP'
          ]
          && request.resource.data.get('sizeBytes', 0) is int
          && request.resource.data.get('sizeBytes', 0) > 0
          && request.resource.data.get('sizeBytes', 0) <= 15728640
          && !('dataBase64' in request.resource.data)
          && (
            !('storagePath' in request.resource.data)
            || request.resource.data.storagePath == ''
            || (
              !request.resource.data.storagePath.matches('.*\\.\\..*')
              && request.resource.data.storagePath.matches('^families/' + familyId + '/files/.*')
            )
          );

        allow update: if isFamilyMember(familyId)
          && request.resource.data.get('familyId', familyId) == familyId
          && !('dataBase64' in request.resource.data)
          && request.resource.data.get('name', resource.data.get('name', '')) is string
          && request.resource.data.get('name', resource.data.get('name', '')).size() > 0
          && request.resource.data.get('name', resource.data.get('name', '')).size() <= 160
          && !request.resource.data.get('name', resource.data.get('name', '')).matches('.*(\\.\\.|/|\\\\).*');

        allow delete: if isFamilyMember(familyId);

        // Firestore Base64 binary chunks are strictly prohibited; actual file contents
        // live exclusively in Google Drive (`FamilyTasks` folder).
        match /chunks/{chunkId} {
          allow read, write: if false;
        }
      }
    }

    // =========================================================================
    // 3. Role-Specific Family Invitations (/family_invites/{inviteCode})
    // =========================================================================
    match /family_invites/{inviteCode} {
      allow get: if isSignedIn() && (
        resource == null
        || isParent(resource.data.get('familyId', ''))
        || resource.data.get('createdById', '') == request.auth.uid
        || resource.data.get('usedByUid', '') == request.auth.uid
        || resource.data.get('redeemedByUid', '') == request.auth.uid
        || (
          resource.data.get('isRevoked', false) == false
          && resource.data.get('isUsed', false) == false
          && resource.data.get('status', 'PENDING') == 'PENDING'
        )
      );

      allow list: if isSignedIn() && isParent(resource.data.get('familyId', ''));

      allow create: if isSignedIn()
        && isParent(request.resource.data.get('familyId', ''))
        && request.resource.data.get('createdById', '') == request.auth.uid
        && (!('invitedRole' in request.resource.data) || request.resource.data.invitedRole in ['PARENT', 'CHILD'])
        && (!('status' in request.resource.data) || request.resource.data.status == 'PENDING')
        && (!('isUsed' in request.resource.data) || request.resource.data.isUsed == false)
        && (!('isRevoked' in request.resource.data) || request.resource.data.isRevoked == false);

      allow update: if isSignedIn() && (
        (
          isParent(resource.data.get('familyId', ''))
          && request.resource.data.get('familyId', '') == resource.data.get('familyId', '')
        )
        || (
          resource.data.get('isRevoked', false) == false
          && resource.data.get('isUsed', false) == false
          && resource.data.get('status', 'PENDING') == 'PENDING'
          && request.resource.data.get('familyId', '') == resource.data.get('familyId', '')
          && request.resource.data.get('invitedRole', '') == resource.data.get('invitedRole', '')
          && request.resource.data.get('isUsed', false) == true
          && (
            request.resource.data.get('usedByUid', '') == request.auth.uid
            || request.resource.data.get('redeemedByUid', '') == request.auth.uid
          )
          && (!('status' in request.resource.data) || request.resource.data.status == 'REDEEMED')
          && (
            !('intendedEmail' in resource.data)
            || resource.data.intendedEmail == ''
            || (request.auth.token.email != null && resource.data.intendedEmail == request.auth.token.email)
          )
        )
      );

      allow delete: if isSignedIn() && isParent(resource.data.get('familyId', ''));
    }

    // =========================================================================
    // 4. Personal & Legacy Top-Level Collections (/tasks/{taskId}, /documents/{docId})
    // =========================================================================
    match /tasks/{taskId} {
      allow get, list: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid
        || (resource.data.get('familyId', '') != '' && isFamilyMember(resource.data.get('familyId', '')))
      );
      allow create: if isSignedIn() && (
        (request.resource.data.get('familyId', '') == '' && request.resource.data.get('userId', '') == request.auth.uid)
        || (request.resource.data.get('familyId', '') != '' && isParent(request.resource.data.get('familyId', '')))
      );
      allow update: if isSignedIn() && (
        (
          resource.data.get('familyId', '') == ''
          && resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        )
        || (
          resource.data.get('familyId', '') != ''
          && (
            isParent(resource.data.get('familyId', ''))
            || (isChild(resource.data.get('familyId', '')) && isChildTaskCompletionOnly())
          )
        )
      );
      allow delete: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid
        || (resource.data.get('familyId', '') != '' && isParent(resource.data.get('familyId', '')))
      );
    }

    match /documents/{docId} {
      allow get, list: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('userId', '') == resource.data.get('userId', '');
      allow delete: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }
  }
}

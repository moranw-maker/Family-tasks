rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         'memberIds' in get(/databases/$(database)/documents/families/$(familyId)).data &&
         get(/databases/$(database)/documents/families/$(familyId)).data.memberIds is list &&
         get(/databases/$(database)/documents/families/$(familyId)).data.memberIds.hasAny([request.auth.uid]))
      );
    }

    function isFamilyParent(familyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role in ['PRIMARY_ADMIN', 'SECONDARY_ADMIN']) ||
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.createdById == request.auth.uid)
      );
    }

    function isFamilyPrimaryAdmin(familyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/families/$(familyId)) &&
         get(/databases/$(database)/documents/families/$(familyId)).data.createdById == request.auth.uid) ||
        (exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'PRIMARY_ADMIN')
      );
    }

    // Family Groups
    match /families/{familyId} {
      allow read: if isAuthenticated() && (
        resource.data.createdById == request.auth.uid ||
        ('memberIds' in resource.data && resource.data.memberIds is list && resource.data.memberIds.hasAny([request.auth.uid])) ||
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.size() == 1 &&
        request.resource.data.memberIds.hasOnly([request.auth.uid]);
      allow update: if (
        isFamilyParent(familyId) &&
        request.resource.data.createdById == resource.data.createdById
      ) || (
        // Joining member adding only their own UID to memberIds when they have a verified invite and member doc
        isAuthenticated() &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        resource.data.memberIds is list &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.memberIds.removeAll(resource.data.memberIds).hasOnly([request.auth.uid]) &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
      );
      allow delete: if isAuthenticated() && resource.data.createdById == request.auth.uid;

      // Family Members
      match /members/{memberId} {
        allow get: if isFamilyMember(familyId) || (isAuthenticated() && request.auth.uid == memberId);
        allow list: if isFamilyMember(familyId);
        // Only parents can create other members; non-parents joining can only create their own non-admin profile with 0 earned points AND must be either in memberIds (without inviteCode) or provide a verified valid invite
        allow create: if isFamilyParent(familyId) || (
          request.auth.uid == memberId &&
          !(request.resource.data.role in ['PRIMARY_ADMIN', 'SECONDARY_ADMIN']) &&
          (!('earnedPoints' in request.resource.data) || request.resource.data.earnedPoints == 0) &&
          (!('spentPoints' in request.resource.data) || request.resource.data.spentPoints == 0) &&
          (
            (exists(/databases/$(database)/documents/families/$(familyId)) &&
             'memberIds' in get(/databases/$(database)/documents/families/$(familyId)).data &&
             get(/databases/$(database)/documents/families/$(familyId)).data.memberIds is list &&
             get(/databases/$(database)/documents/families/$(familyId)).data.memberIds.hasAny([request.auth.uid]) &&
             !('inviteCode' in request.resource.data)) ||
            ('inviteCode' in request.resource.data &&
             request.resource.data.inviteCode is string &&
             exists(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)) &&
             get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.familyId == familyId &&
             (!('isRevoked' in get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data) ||
              get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.isRevoked == false) &&
             (!('isUsed' in get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data) ||
              get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.isUsed == false) &&
             (!('expiresAtMillis' in get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data) ||
              request.time.toMillis() < get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.expiresAtMillis) &&
             (!('intendedEmail' in get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data) ||
              get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.intendedEmail == "" ||
              get(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.intendedEmail == request.auth.token.email) &&
             // Mandatory atomic consumption: the invite must be marked as used by this user in the same atomic operation
             getAfter(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.isUsed == true &&
             getAfter(/databases/$(database)/documents/family_invites/$(request.resource.data.inviteCode)).data.usedByUid == request.auth.uid)
          )
        );
        // Parent updates: only primary admin can assign/demote PRIMARY_ADMIN role
        allow update: if (
          isFamilyPrimaryAdmin(familyId)
        ) || (
          isFamilyParent(familyId) &&
          request.resource.data.role != 'PRIMARY_ADMIN' &&
          resource.data.role != 'PRIMARY_ADMIN'
        ) || (
          // Children/members can only update their own avatar/name/color, never points, role, or approval
          request.auth.uid == memberId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarEmoji', 'name', 'colorHex', 'schoolGrade', 'updatedAt'])
        );
        allow delete: if isFamilyParent(familyId) && resource.data.role != 'PRIMARY_ADMIN';
      }

      // Family Tasks
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        // Parents can create any task; child creating task cannot self-approve or assign excessive points
        allow create: if (
          isFamilyParent(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0
        ) || (
          isFamilyMember(familyId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          (!('approvedByParent' in request.resource.data) || request.resource.data.approvedByParent == false) &&
          (!('points' in request.resource.data) || request.resource.data.points == 0)
        );
        allow update: if (
          isFamilyParent(familyId) &&
          request.resource.data.familyId == resource.data.familyId
        ) || (
          // Child can ONLY update tasks assigned to them, and ONLY explicitly permitted completion fields; cannot touch points or approvedByParent
          isFamilyMember(familyId) &&
          ((('assignedToMemberId' in resource.data) && resource.data.assignedToMemberId == request.auth.uid) ||
           (('assignedMemberId' in resource.data) && resource.data.assignedMemberId == request.auth.uid)) &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.points == resource.data.points &&
          request.resource.data.approvedByParent == resource.data.approvedByParent &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCompleted', 'completedAtMillis', 'completedByMemberId', 'updatedAt'])
        );
        allow delete: if isFamilyParent(familyId);
      }

      // Rewards
      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyParent(familyId);
        allow update: if isFamilyParent(familyId) || (
          // Child can claim a reward for themselves, but cannot approve it or change pointsCost/title
          isFamilyMember(familyId) &&
          (!('isClaimed' in resource.data) || resource.data.isClaimed == false) &&
          request.resource.data.pointsCost == resource.data.pointsCost &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.claimedByMemberId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isClaimed', 'claimedByMemberId', 'claimedAtMillis', 'updatedAt'])
        );
      }
    }

    // Top-level invite lookup for family joining
    match /family_invites/{inviteCode} {
      // Prevent unauthorized enumeration of invitations across all families
      allow list: if isAuthenticated() && isFamilyParent(resource.data.familyId);

      // Validate single document read (get) with expiration, revocation, usage and recipient checks
      allow get: if isAuthenticated() && (
        isFamilyParent(resource.data.familyId) ||
        resource.data.createdById == request.auth.uid ||
        (
          (!('isRevoked' in resource.data) || resource.data.isRevoked == false) &&
          (!('isUsed' in resource.data) || resource.data.isUsed == false) &&
          (!('expiresAtMillis' in resource.data) || request.time.toMillis() < resource.data.expiresAtMillis) &&
          (!('intendedEmail' in resource.data) || resource.data.intendedEmail == "" || resource.data.intendedEmail == request.auth.token.email)
        )
      );

      // Only authenticated family parent can create invites for their family
      allow create: if isAuthenticated() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.familyId is string &&
        isFamilyParent(request.resource.data.familyId) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'PRIMARY_ADMIN') &&
        (!('isRevoked' in request.resource.data) || request.resource.data.isRevoked == false) &&
        (!('isUsed' in request.resource.data) || request.resource.data.isUsed == false) &&
        (!('expiresAtMillis' in request.resource.data) || request.resource.data.expiresAtMillis > request.time.toMillis());

      // Parents can update invites (revoke, renew) or a joining member can mark single-use invite as used
      allow update: if isAuthenticated() && (
        (
          isFamilyParent(resource.data.familyId) &&
          request.resource.data.familyId == resource.data.familyId
        ) || (
          (!('isRevoked' in resource.data) || resource.data.isRevoked == false) &&
          (!('isUsed' in resource.data) || resource.data.isUsed == false) &&
          (!('expiresAtMillis' in resource.data) || request.time.toMillis() < resource.data.expiresAtMillis) &&
          (!('intendedEmail' in resource.data) || resource.data.intendedEmail == "" || resource.data.intendedEmail == request.auth.token.email) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedByUid', 'usedAtMillis', 'updatedAt']) &&
          request.resource.data.isUsed == true &&
          request.resource.data.usedByUid == request.auth.uid &&
          !exists(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.id == request.auth.uid &&
          getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.inviteCode == inviteCode
        )
      );

      allow delete: if isAuthenticated() && (
        resource.data.createdById == request.auth.uid ||
        isFamilyParent(resource.data.familyId)
      );
    }

    // Top-level user profile: only user or family members can read private profile information
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data.familyId is string && resource.data.familyId != "" && isFamilyMember(resource.data.familyId))
      );
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Legacy/top-level tasks collection for backward compatibility
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.familyId is string && resource.data.familyId != "" && isFamilyMember(resource.data.familyId))
      );
      allow create: if isAuthenticated() && (
        // Standalone user task (no familyId)
        ((!('familyId' in request.resource.data) || request.resource.data.familyId == "") && request.resource.data.userId == request.auth.uid) ||
        // Family parent task creation
        (request.resource.data.familyId is string && request.resource.data.familyId != "" && isFamilyParent(request.resource.data.familyId)) ||
        // Family child task creation: proposal only, cannot self-approve or assign points
        (request.resource.data.familyId is string && request.resource.data.familyId != "" && isFamilyMember(request.resource.data.familyId) &&
         (!('approvedByParent' in request.resource.data) || request.resource.data.approvedByParent == false) &&
         (!('points' in request.resource.data) || request.resource.data.points == 0))
      );
      allow update: if isAuthenticated() && (
        // Standalone user task update
        ((!('familyId' in resource.data) || resource.data.familyId == "") && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        // Family parent task update
        (resource.data.familyId is string && resource.data.familyId != "" && isFamilyParent(resource.data.familyId) && request.resource.data.familyId == resource.data.familyId) ||
        // Family child task update: ONLY for tasks assigned to this user, and ONLY completion fields; cannot touch points or approvedByParent
        (resource.data.familyId is string && resource.data.familyId != "" && isFamilyMember(resource.data.familyId) &&
         ((('assignedToMemberId' in resource.data) && resource.data.assignedToMemberId == request.auth.uid) ||
          (('assignedMemberId' in resource.data) && resource.data.assignedMemberId == request.auth.uid)) &&
         request.resource.data.familyId == resource.data.familyId &&
         request.resource.data.points == resource.data.points &&
         request.resource.data.approvedByParent == resource.data.approvedByParent &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCompleted', 'completedAtMillis', 'completedByMemberId', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (
        ((!('familyId' in resource.data) || resource.data.familyId == "") && resource.data.userId == request.auth.uid) ||
        (resource.data.familyId is string && resource.data.familyId != "" && isFamilyParent(resource.data.familyId))
      );
    }

    // Legacy documents: separated operations, strict ownership validation
    match /documents/{documentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
